APP_NAME=LettuGrow
APP_ENV=local
APP_KEY=
# ⚠️ WAJIB false begitu backend diakses dari internet (ngrok). true = stack trace
# lengkap + config bocor ke HP user saat ada error.
APP_DEBUG=true
APP_URL=http://localhost:8000

# Default --host untuk `php artisan serve`. 0.0.0.0 supaya server bisa diakses
# dari perangkat lain (HP/emulator) di jaringan mana pun, tanpa flag manual.
SERVER_HOST=0.0.0.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Flask ML microservice (internal, hanya dipanggil Laravel).
# Port harus sama dengan default app.run() di ML/api/app.py (PORT, default 5000).
FLASK_ML_BASE_URL=http://127.0.0.1:5000
FLASK_ML_TIMEOUT=8

# Firebase: verifikasi ID token user di sisi server (middleware firebase.auth).
# Letakkan service account JSON dari Console Firebase di storage/app/private/ (folder ini
# sudah di-gitignore) lalu arahkan path-nya ke sini. Tanpa nilai ini, API membalas 503.
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=

# Rahasia bersama Laravel -> Flask ML (header X-ML-Token). Generate: openssl rand -hex 32
# Nilai yang sama harus di-export ke proses Flask sebagai ML_SHARED_SECRET, misalnya:
#   $env:ML_SHARED_SECRET="<nilai>"; python ML/api/app.py
# Kosong = Flask menolak semua panggilan /predict (fail closed).
FLASK_ML_SHARED_SECRET=

# Akun admin Filament (dashboard /admin).Seeder MENOLAK jalan tanpa keduanya,
# jadi tidak ada lagi password default 12345678 di repo. Isi sendiri, minimal 12 karakter.
ADMIN_NAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
